# Release-pinned image. Set HP_IMAGE=aegislure:local when building locally.
HP_IMAGE=ghcr.io/zcxads666/aegislure:v0.1.0

# Listener and container identity. Public honeypot ports are open by default;
# keep the admin listener on loopback unless a trusted proxy is used.
HP_PUBLIC_PORT_BIND_IP=0.0.0.0
HP_ADMIN_PORT_BIND_IP=0.0.0.0
HP_ADMIN_PORT=28443
HP_PROFILES=new-api,vllm,ollama,sglang,localai
HP_CONTAINER_UID=1000
HP_CONTAINER_GID=1000

# SQLite is the default single-node backend.
HP_DB_DRIVER=sqlite
HP_DATABASE_URL=
HP_DATABASE_URL_FILE=

# PostgreSQL component settings. Use these with docker-compose.pg.yml.
HP_DB_HOST=postgres
HP_DB_PORT=5432
HP_DB_NAME=aegislure
HP_DB_USER=aegislure
HP_DB_SSLMODE=disable
HP_POSTGRES_PASSWORD_FILE=./runtime/secrets/postgres_password

# For a managed PostgreSQL service, set HP_DATABASE_URL or
# HP_DATABASE_URL_FILE and do not start the bundled-pg Compose profile.
# HP_DATABASE_URL=postgres://aegislure:REPLACE_ME@db.example.com:5432/aegislure?sslmode=require
# When using Compose, a URL file under runtime/secrets is visible in the
# container as /var/lib/aegislure/secrets/<name>.
# HP_DATABASE_URL_FILE=/var/lib/aegislure/secrets/database_url

# TLS files are generated by install.sh for the local admin listener.
# HP_TLS_CERT=/var/lib/aegislure/secrets/admin.crt
# HP_TLS_KEY=/var/lib/aegislure/secrets/admin.key
