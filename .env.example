# Release-pinned image. Set HP_IMAGE=aegislure:local when building locally.
HP_IMAGE=ghcr.io/zcxads666/aegislure:v0.1.0

# Listener and container identity. Public honeypot and admin ports are open by
# default; restrict the admin listener at the host/firewall layer if needed.
HP_PUBLIC_PORT_BIND_IP=0.0.0.0
HP_ADMIN_PORT_BIND_IP=0.0.0.0
HP_ADMIN_PORT=28443
HP_PROFILES=new-api,vllm,ollama,sglang,localai,sub2api
HP_CONTAINER_UID=1000
HP_CONTAINER_GID=1000

# SQLite is the default single-node backend.
HP_DB_DRIVER=sqlite
HP_DATABASE_URL=
HP_DATABASE_URL_FILE=

# PostgreSQL component settings. Use these with docker-compose.pg.yml.
HP_DB_HOST=postgres
HP_DB_PORT=5432
HP_DB_NAME=aegislure
HP_DB_USER=aegislure
HP_DB_SSLMODE=disable
HP_POSTGRES_PASSWORD_FILE=./runtime/secrets/postgres_password
# Bundled PostgreSQL uses the application-owned copy made by the secret
# initializer. For an external PostgreSQL service, use
# /run/secrets/aegislure_db_password or another in-container secret path.
HP_DB_PASSWORD_FILE=/run/aegislure-db-secrets/application_password

# For a managed PostgreSQL service, set HP_DATABASE_URL or
# HP_DATABASE_URL_FILE and do not start the bundled-pg Compose profile.
# HP_DATABASE_URL=postgres://aegislure:REPLACE_ME@db.example.com:5432/aegislure?sslmode=require
# When using Compose, a URL file under runtime/secrets is visible in the
# container as /var/lib/aegislure/secrets/<name>.
# HP_DATABASE_URL_FILE=/var/lib/aegislure/secrets/database_url

# IP geolocation provider. Keep MaxMind for the existing GeoLite2 files, or
# choose ipinfo_mmdb for IPinfo's offline Location + ASN MMDB files, or
# ipinfo_api (City + ASN) / ipinfo_lite (country + ASN) for the token-backed API.
# Docker Compose keeps edge_net masquerading enabled so these providers can
# reach IPinfo over HTTPS. If the host firewall restricts egress, allow TCP
# 443 to ipinfo.io and api.ipinfo.io; bait_net/admin_net stay internal.
HP_GEOIP_PROVIDER=maxmind
HP_MAXMIND_CITY_DB=/var/lib/aegislure/data/geoip/GeoLite2-City.mmdb
HP_MAXMIND_ASN_DB=/var/lib/aegislure/data/geoip/GeoLite2-ASN.mmdb
HP_IPINFO_LOCATION_DB=/var/lib/aegislure/data/geoip/ipinfo_location.mmdb
HP_IPINFO_ASN_DB=/var/lib/aegislure/data/geoip/ipinfo_asn.mmdb
# Set when HP_GEOIP_PROVIDER=ipinfo_api or ipinfo_lite. Prefer a protected
# secret file or the admin Settings page in production.
HP_IPINFO_LITE_TOKEN=
# Example inside the container: /var/lib/aegislure/secrets/ipinfo_token
HP_IPINFO_LITE_TOKEN_FILE=

# TLS files are generated by install.sh for the local admin listener.
# HP_TLS_CERT=/var/lib/aegislure/secrets/admin.crt
# HP_TLS_KEY=/var/lib/aegislure/secrets/admin.key
