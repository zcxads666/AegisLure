#!/usr/bin/env bash
set -Eeuo pipefail
ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"
if [[ -f scripts/env.sh ]]; then
  source scripts/env.sh
fi
if command -v go >/dev/null 2>&1; then
  exec go run ./cmd/hpctl "$@"
fi
if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
  case "${1:-}" in
    start) exec docker compose up -d ;;
    stop) exec docker compose stop ;;
    restart) exec docker compose restart ;;
    *) exec docker compose run --rm --no-deps --entrypoint /usr/local/bin/hpctl aegislure "$@" ;;
  esac
fi
echo "Docker Compose or Go is required" >&2
exit 1
